<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme matched to the macOS original's screenshots: near-black window,
         #3a3a3a chrome, #4a90e2 accent, light gray text. Everything downstream of M0
         (sliders, panels, dialogs) layers on top of these names. -->

    <Color x:Key="Color.Window">#FF1E1E1E</Color>
    <Color x:Key="Color.Chrome">#FF3A3A3A</Color>
    <Color x:Key="Color.Panel">#FF2E2E2E</Color>
    <Color x:Key="Color.Control">#FF3D3D3D</Color>
    <Color x:Key="Color.ControlHover">#FF484848</Color>
    <Color x:Key="Color.Popup">#FF2F2F2F</Color>
    <Color x:Key="Color.Divider">#FF555555</Color>
    <Color x:Key="Color.Accent">#FF4A90E2</Color>
    <Color x:Key="Color.AccentHover">#FF5BA0F2</Color>
    <Color x:Key="Color.TextPrimary">#FFE8E8E8</Color>
    <Color x:Key="Color.TextSecondary">#FFB0B0B0</Color>
    <Color x:Key="Color.TextDisabled">#FF707070</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Chrome" Color="{StaticResource Color.Chrome}" />
    <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}" />
    <SolidColorBrush x:Key="Brush.Control" Color="{StaticResource Color.Control}" />
    <SolidColorBrush x:Key="Brush.ControlHover" Color="{StaticResource Color.ControlHover}" />
    <SolidColorBrush x:Key="Brush.Popup" Color="{StaticResource Color.Popup}" />
    <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Color.Divider}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />

    <!-- Window -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Brush.Window}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- Menu bar -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource Brush.Chrome}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource Brush.Divider}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="6,4" />
    </Style>

    <ControlTemplate x:Key="MenuItem.TopLevel" TargetType="MenuItem">
        <Border x:Name="Root" Background="Transparent" Padding="8,4">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.ControlHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuItem.Submenu" TargetType="MenuItem">
        <Grid>
            <Border x:Name="Root" Background="Transparent" Padding="10,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               Margin="24,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Popup IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Bottom"
                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                <Border Background="{StaticResource Brush.Popup}" BorderBrush="{StaticResource Brush.Divider}"
                        BorderThickness="1" Margin="0,2,8,8" Padding="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" />
                    </Border.Effect>
                    <ItemsPresenter />
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.ControlHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="MenuItem">
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource MenuItem.TopLevel}" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource MenuItem.TopLevel}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource MenuItem.Submenu}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource MenuItem.Submenu}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tabs: the project tab strip under the menu bar -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource Brush.Chrome}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Root" Background="Transparent" BorderThickness="0,0,0,2"
                            BorderBrush="Transparent" Padding="14,6" Margin="0,0,2,0">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.ControlHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.Control}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Divider}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Brush.Popup}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Divider}" />
    </Style>
</ResourceDictionary>
