<Window x:Class="Compositor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Compositor.Controls"
        Title="Compositor" Width="1180" Height="780"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <!-- Upstream ContentView/ProjectWorkspace: menu bar, tool header, canvas + Layers
         panel docked right. M1 wires the core editing loop end to end. -->
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="New Canvas…" InputGestureText="Ctrl+N" Click="NewCanvas_Click"/>
                <MenuItem Header="Open Project…" InputGestureText="Ctrl+O" Click="OpenProject_Click"/>
                <MenuItem Header="Open Recent" Name="RecentMenu" SubmenuOpened="RecentMenu_Opened"/>
                <Separator/>
                <MenuItem Header="Import Image as Layer…" Click="ImportImage_Click"/>
                <Separator/>
                <MenuItem Header="Save" InputGestureText="Ctrl+S" Click="Save_Click"/>
                <MenuItem Header="Save As…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click"/>
                <Separator/>
                <MenuItem Header="Export PNG…" Click="ExportPng_Click"/>
                <MenuItem Header="Export JPEG…" Click="ExportJpeg_Click"/>
                <Separator/>
                <MenuItem Header="Close Project" Click="CloseProject_Click"/>
                <Separator/>
                <MenuItem Header="Exit" InputGestureText="Alt+F4" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                <MenuItem Header="Redo" InputGestureText="Ctrl+Shift+Z" Click="Redo_Click"/>
                <Separator/>
                <MenuItem Header="Fill with Foreground Color" Click="FillForeground_Click"/>
            </MenuItem>
            <MenuItem Header="_Image">
                <MenuItem Header="Canvas Size…" Click="CanvasSize_Click"/>
                <Separator/>
                <MenuItem Header="Flip Canvas Horizontal" Click="FlipCanvasH_Click"/>
                <MenuItem Header="Flip Canvas Vertical" Click="FlipCanvasV_Click"/>
            </MenuItem>
            <MenuItem Header="_Layer">
                <MenuItem Header="New Blank Layer" InputGestureText="Ctrl+Shift+N" Click="NewLayer_Click"/>
                <MenuItem Header="Rename Layer…" Click="RenameLayer_Click"/>
                <Separator/>
                <MenuItem Header="Move Layer Up" InputGestureText="Ctrl+]" Click="LayerUp_Click"/>
                <MenuItem Header="Move Layer Down" InputGestureText="Ctrl+[" Click="LayerDown_Click"/>
                <Separator/>
                <MenuItem Header="Merge Down" InputGestureText="Ctrl+E" Click="MergeDown_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Fit Canvas" InputGestureText="Ctrl+0" Click="FitCanvas_Click"/>
                <MenuItem Header="Actual Pixels" InputGestureText="Ctrl+1" Click="ActualPixels_Click"/>
                <MenuItem Header="Zoom In" Click="ZoomIn_Click"/>
                <MenuItem Header="Zoom Out" Click="ZoomOut_Click"/>
                <Separator/>
                <MenuItem Header="Rulers" InputGestureText="Ctrl+R" Click="Rulers_Click"/>
                <Separator/>
                <MenuItem Header="Clear Guides" Click="ClearGuides_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="About Compositor" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Tool header (upstream NavigationToolHeader + BrushControls); wraps onto a
             second row on narrow windows instead of clipping off the right edge. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Chrome}"
                BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="10,6">
            <WrapPanel>
                <WrapPanel.Resources>
                    <Style TargetType="RadioButton">
                        <Setter Property="Margin" Value="0,0,10,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </WrapPanel.Resources>
                <RadioButton Name="ToolMove" Content="Move (V)" GroupName="tool" Checked="Tool_Checked"/>
                <RadioButton Name="ToolBrush" Content="Brush (B)" GroupName="tool" Checked="Tool_Checked"/>
                <RadioButton Name="ToolEraser" Content="Eraser (E)" GroupName="tool" Checked="Tool_Checked"/>
                <RadioButton Name="ToolPan" Content="Pan (H)" GroupName="tool" Checked="Tool_Checked" Margin="0,0,14,0"/>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,1,12,1"/>
                <TextBlock Text="Size " VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}"/>
                <Slider Name="BrushSize" Width="70" Minimum="1" Maximum="300" Value="24"
                        ValueChanged="BrushSetting_Changed" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Hardness " VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}"/>
                <Slider Name="BrushHardness" Width="60" Minimum="0" Maximum="100" Value="80"
                        ValueChanged="BrushSetting_Changed" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Opacity " VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}"/>
                <Slider Name="BrushOpacity" Width="60" Minimum="1" Maximum="100" Value="100"
                        ValueChanged="BrushSetting_Changed" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,1,12,1"/>
                <Button Name="ForegroundSwatch" Width="24" Height="24" ToolTip="Foreground color"
                        Click="Foreground_Click"/>
            </WrapPanel>
        </Border>

        <!-- Project tab strip -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Chrome}"
                BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="8,0,8,0">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabItem Header="Untitled" Name="ProjectTab"/>
            </TabControl>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.Chrome}" Padding="10,3">
            <DockPanel>
                <TextBlock Name="StatusRight" DockPanel.Dock="Right" Foreground="{StaticResource Brush.TextSecondary}"/>
                <TextBlock Name="StatusLeft" Foreground="{StaticResource Brush.TextSecondary}"/>
            </DockPanel>
        </Border>

        <!-- Layers panel -->
        <Border DockPanel.Dock="Right" Width="268" Name="LayersHost" Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1,0,0,0">
            
        </Border>

        <!-- Canvas -->
        <Border Background="#FF262626" Name="CanvasHost">
            
        </Border>
    </DockPanel>
</Window>
