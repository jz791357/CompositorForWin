<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.4.5-win.0</Version>
    <AssemblyName>Compositor</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Compositor</RootNamespace>
  </PropertyGroup>

  <!-- Folder/color dialogs come from Windows Forms without its global usings, so WPF
       type names stay unambiguous. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Compositor.Core\Compositor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Compositor.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="portable-readme.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="start-diagnostics.bat" CopyToOutputDirectory="PreserveNewest" />
    <None Include="start-softwarerendering.bat" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The C pixel kernels live in Compositor.Native (msbuild/vcxproj, built separately
       or via the solution). Copy the DLL next to the app whenever it has been built. -->
  <ItemGroup>
    <None Include="..\Compositor.Native\out\Compositor.Native.dll"
          Condition="Exists('..\Compositor.Native\out\Compositor.Native.dll')"
          Link="Compositor.Native.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
